# SMAP 서버 기능 — Vercel 프로젝트 설정 → Environment Variables 에 넣는다 (이 파일엔 실제 키를 쓰지 않는다)
# 키가 없으면 해당 기능만 꺼지고 앱은 브라우저 방식으로 동작한다. 상태 확인: /api/health

# 말로 길 묻기 문장 해석 · 불편 접수 AI 분류 (Claude) — console.anthropic.com
ANTHROPIC_API_KEY=

# 서버 음성인식 (OpenAI Whisper) — platform.openai.com
OPENAI_API_KEY=

# 불편 접수 · 화살표 보정값 저장 (Neon Postgres) — Vercel 대시보드 → Storage → Neon 연결 시 자동으로 들어감
DATABASE_URL=

# 관리자 화면(?admin=1)·보정값 서버 저장에 쓰는 비밀번호 (아무 긴 문자열)
ADMIN_KEY=

# 제보 사진 저장 (Vercel Blob, 비공개) — Vercel 대시보드 → Storage → Blob 연결 시 자동으로 들어감 (BLOB_STORE_ID 방식이면 이 값 없이도 동작)
BLOB_READ_WRITE_TOKEN=

# 지금 날씨 (기상청 초단기실황) — data.go.kr 「기상청_단기예보 조회서비스」 활용신청 후 일반 인증키(Decoding)
# 없으면 Open-Meteo(키 불필요)로 대신 받아온다. 비·눈이면 실내·지하 길 우선
DATA_GO_KR_KEY=

# 사진 저장소 (Supabase Storage 공개 버킷) — 예: https://<프로젝트ID>.supabase.co/storage/v1/object/public/smap
# 비우면 public/ 폴더 사진을 그대로 씀. 이 값은 공개 주소라 비밀 아님
VITE_IMG_BASE=

# 편집기 수정값 공유 저장소 (Supabase 표 smap_edit_versions) — anon 공개 키라 브라우저에 실려도 됨
# 비우면 편집기 수정값은 이 브라우저(localStorage)에만 저장된다
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
